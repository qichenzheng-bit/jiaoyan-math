[Unit]
Description=Jiaoyan Math API and web
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/jiaoyan-app/current/backend
EnvironmentFile=%h/jiaoyan-app/config/app.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/jiaoyan-app/current/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
