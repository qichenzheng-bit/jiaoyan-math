[Unit]
Description=Weiguang private video production engine
After=network.target postgresql.service
[Service]
Type=simple
User=jiaoyan-video
Group=jiaoyan-video
WorkingDirectory=/opt/jiaoyan-video/source
EnvironmentFile=/etc/jiaoyan-video/engine.env
Environment=WEIGUANG_NATIVE_QUEUE=1
Environment=WEIGUANG_STORAGE=/var/lib/jiaoyan-video
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/jiaoyan-video/source/app/backend/src:/opt/jiaoyan-video/source/app/animation_engine/src
ExecStart=/opt/jiaoyan-video/venv/bin/python -m uvicorn weiguang_backend.main:create_app --factory --host 127.0.0.1 --port 8766
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
